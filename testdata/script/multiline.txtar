# Under a filter a stack trace goes the way of the entry before it, even a line of it that holds pairs:
# an indented line is never logfmt.
stdin traceback.log
exec logpretty --utc --level error
cmp stdout want_traceback
! stderr .

# What kubectl logs --prefix --timestamps writes is read on every line, so a JSON line after it is an entry
# and the plain lines of its stack trace follow it; its timestamp is the time of a line without its own.
stdin pod.log
exec logpretty --utc
cmp stdout want_pod
stdin pod.log
exec logpretty --utc --level error
cmp stdout want_pod_error
! stderr .

# docker compose mixes the lines of its containers: a stack trace goes the way of the last entry of its own
# container, whatever the others write in between.
stdin compose.log
exec logpretty --utc --level error
cmp stdout want_compose
! stderr .

# A value with line breaks, such as the stack trace zap keeps in a field, is unfolded under its entry,
# and --no-expand keeps it in the line.
stdin zap.log
exec logpretty --utc
cmp stdout want_zap
stdin zap.log
exec logpretty --utc --no-expand
cmp stdout want_zap_flat
! stderr .

# The time kubectl wrote is the time --where compares.
stdin stamps.log
exec logpretty --utc --where 'time>=2026-10-11T12:00:01Z'
cmp stdout want_stamps
! stderr .

