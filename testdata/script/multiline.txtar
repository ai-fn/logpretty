# Under a filter a stack trace goes the way of the entry before it, even a line of it that holds pairs:
# an indented line is never logfmt.
stdin traceback.log
exec logpretty --utc --level error
cmp stdout want_traceback
! stderr .

# What kubectl logs --prefix --timestamps writes is read on every line, so a JSON line after it is an entry
# and the plain lines of its stack trace follow it; its timestamp is the time of a line without its own.
stdin pod.log
exec logpretty --utc
cmp stdout want_pod
stdin pod.log
exec logpretty --utc --level error
cmp stdout want_pod_error
! stderr .

# The time kubectl wrote is the time --where compares.
stdin stamps.log
exec logpretty --utc --where 'time>=2026-10-11T12:00:01Z'
cmp stdout want_stamps
! stderr .

