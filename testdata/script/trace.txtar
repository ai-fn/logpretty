# --trace keeps the entries of one trace under any key the trace key finds, or with no id by the field trace;
# a plain line goes the way of the entry before it, and the banner before the first entry is hidden.
stdin input.log
exec logpretty --utc --trace 00f067aa0ba902b7
cmp stdout want_one
! stderr .

stdin input.log
exec logpretty --utc --trace 4bf92f3577b34da6a3ce929d0e0e4736 --trace a3ce929d0e0e4736
cmp stdout want_two
! stderr .

# With --level, an entry must meet both.
stdin input.log
exec logpretty --utc --level error --trace 4bf92f3577b34da6a3ce929d0e0e4736 --trace a3ce929d0e0e4736
cmp stdout want_level
! stderr .

# The id must match whole; its start is found with --where.
stdin input.log
exec logpretty --utc --trace 4bf9
! stdout .
! stderr .

stdin input.log
exec logpretty --utc --where 'trace~^4bf9'
cmp stdout want_prefix
! stderr .

# An empty id is a mistake in the arguments.
! exec logpretty --trace=
stderr '^logpretty: invalid value "" for flag -trace: the trace id is empty$'
! stdout .

