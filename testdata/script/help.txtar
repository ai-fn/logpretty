# --help prints the help to stdout and succeeds; -h is the same.
exec logpretty --help
stdout '^Usage: logpretty \[flags\] < input$'
stdout '^      --level LEVEL '
stdout '^      --where EXPR '
stdout '^      --trace ID '
stdout '^      --plain MODE '
stdout '^      --fields LIST '
stdout '^      --no-time '
stdout '^      --color WHEN '
stdout '^      --utc '
stdout '^      --max-line SIZE '
stdout '^      --version '
stdout '^  -h, --help '
stdout '^Expressions:$'
stdout '^Examples:$'
! stderr .
cp stdout long

exec logpretty -h
cmp stdout long
! stderr .

# A flag with one dash still works.
stdin input.log
exec logpretty -utc -color=never
stdout '^12:00:00.000 hi$'

-- input.log --
{"time":"2026-10-11T12:00:00Z","msg":"hi"}
