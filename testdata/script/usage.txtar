# Invalid arguments fail with one line on stderr and a pointer to the help; nothing goes to stdout.
! exec logpretty --nope
stderr '^logpretty: flag provided but not defined: -nope$'
stderr '^Run ''logpretty --help'' for usage\.$'
! stderr 'Usage:'
! stdout .

! exec logpretty file.log
stderr '^logpretty: unexpected argument "file.log"$'
! stdout .

! exec logpretty --max-line 0
stderr '^logpretty: invalid value "0" for flag -max-line: want a positive size in bytes, such as 4096, 64K or 1M$'
! stdout .

! exec logpretty --color
stderr '^logpretty: flag needs an argument: -color$'
! stdout .

# Input is not read when the arguments are wrong.
stdin input.log
! exec logpretty --nope
! stdout .

-- input.log --
{"msg":"hello"}
